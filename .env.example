# Servidor Express
PORT=4000
NODE_ENV=development

# Base de Datos PostgreSQL (Drizzle ORM)
DATABASE_URL=postgres://postgres:postgres@localhost:5432/rally_db

# Seguridad y Autenticación JWT para Administradores
JWT_SECRET=super_secret_jwt_key_rally_2026_seismic_flood_platform
JWT_EXPIRES_IN=7d

# Credenciales de Administrador inicial por defecto (Seed)
ADMIN_NAME=Administrador del Sistema
ADMIN_EMAIL=admin@rally2026.com
ADMIN_PASSWORD=admin123456

# Parámetros de Telemetría y Alertas
# Umbral de aceleración total (magnitud en m/s^2) para disparar alerta de sismo
# (1g estándar es ~9.81 m/s^2; por encima de 14.5 m/s^2 denota sacudida fuerte)
SEISMIC_ACCEL_THRESHOLD=14.5

# Tiempo en segundos tras el cual un dispositivo sin heartbeat pasa a 'offline'
HEARTBEAT_TIMEOUT_SECONDS=120

# Integración con API externa de OCR / Detección de Inundaciones
# Si se deja vacío, el sistema utilizará el motor modular simulado/heurístico listo para producción
EXTERNAL_OCR_API_URL=
EXTERNAL_OCR_API_KEY=

# CORS
CORS_ORIGIN=*
